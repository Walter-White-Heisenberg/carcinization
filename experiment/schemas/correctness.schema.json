{
  "type": "object",
  "properties": {
    "judgments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "label": {
            "enum": [
              "verified_correct",
              "verified_error",
              "unverified"
            ]
          },
          "verification_level": {
            "enum": [
              "internal",
              "external_literature",
              "execution",
              "formal_or_expert"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exact_locations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          },
          "impact": {
            "enum": [
              "local",
              "affects_key_result",
              "blocks_core_claim",
              "uncertain"
            ]
          }
        },
        "required": [
          "claim_id",
          "label",
          "verification_level",
          "evidence_ids",
          "exact_locations",
          "reason",
          "impact"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "judgments"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
