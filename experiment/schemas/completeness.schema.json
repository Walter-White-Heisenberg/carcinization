{
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "sufficient",
              "partial",
              "missing",
              "not_applicable",
              "unassessable"
            ]
          },
          "locations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependent_claim_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "obstacle_if_missing": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "item_id",
          "status",
          "locations",
          "dependent_claim_ids",
          "obstacle_if_missing",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
