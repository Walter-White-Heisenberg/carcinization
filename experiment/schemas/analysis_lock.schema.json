{
  "type": "object",
  "properties": {
    "activation_sha256": {
      "type": "string",
      "minLength": 1
    },
    "initial_registry_sha256": {
      "type": "string",
      "minLength": 1
    },
    "roster_sha256": {
      "type": "string",
      "minLength": 1
    },
    "run_log": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "new_registry": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "measurement_files": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "source_documents",
              "blinding_map",
              "segmentation",
              "human_annotations",
              "role_sequences",
              "adjudication_tasks",
              "metric_records",
              "reader_responses",
              "other_evidence"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "format": {
            "enum": [
              "json",
              "jsonl",
              "raw"
            ]
          },
          "schema_name": {
            "enum": [
              null,
              "annotation",
              "task_output_record",
              "metric_record"
            ]
          }
        },
        "required": [
          "kind",
          "path",
          "sha256",
          "format",
          "schema_name"
        ],
        "additionalProperties": false
      }
    },
    "registry_approved_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "analysis_locked_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "schema_version": {
      "const": "2.3"
    },
    "namespace": {
      "const": "CONVERGENCE"
    },
    "study_id": {
      "const": "conv_review_trajectory"
    },
    "evidence_class": {
      "enum": [
        "engineering_validation",
        "synthetic_identifiability",
        "unapproved_candidate_discovery",
        "pilot_llm_judge_labeled",
        "pilot_llm_judge_labeled_batch2",
        "diagnostic_only"
      ]
    },
    "record_id": {
      "type": "string",
      "pattern": "^conv_[A-Za-z0-9_-]+$"
    },
    "label_source": {
      "type": "string",
      "minLength": 1
    },
    "rubric_version": {
      "type": "string",
      "minLength": 1
    },
    "fixture": {
      "type": "boolean"
    },
    "illustrative": {
      "type": "boolean"
    },
    "data_origin": {
      "enum": [
        "real",
        "illustrative",
        "fixture",
        "synthetic"
      ]
    },
    "parent_record_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "activation_sha256",
    "initial_registry_sha256",
    "roster_sha256",
    "run_log",
    "new_registry",
    "measurement_files",
    "registry_approved_at_utc",
    "analysis_locked_at_utc",
    "schema_version",
    "namespace",
    "study_id",
    "record_id",
    "evidence_class",
    "label_source",
    "rubric_version",
    "fixture",
    "illustrative",
    "data_origin",
    "parent_record_ids"
  ],
  "additionalProperties": false
}
