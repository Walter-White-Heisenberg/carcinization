{
  "type": "object",
  "properties": {
    "verdict": {
      "enum": [
        "changes_requested",
        "no_unresolved_design_issues",
        "cannot_assess"
      ]
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "blocking",
              "major",
              "minor"
            ]
          },
          "artifact_location": {
            "type": "string",
            "minLength": 1
          },
          "problem": {
            "type": "string"
          },
          "consequence": {
            "type": "string"
          },
          "proposed_fix": {
            "type": "string"
          },
          "verification_step": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "severity",
          "artifact_location",
          "problem",
          "consequence",
          "proposed_fix",
          "verification_step"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "verdict",
    "scope",
    "issues",
    "limitations"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "no_unresolved_design_issues"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "issues": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "changes_requested"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "issues": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
