{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "record_id",
    "paper_id",
    "track",
    "condition",
    "trajectory_id",
    "round",
    "stage",
    "status",
    "parent_record_ids",
    "raw_text",
    "model_snapshot",
    "input_sha256",
    "output_sha256",
    "attempt",
    "usage",
    "illustrative",
    "namespace",
    "study_id",
    "evidence_class",
    "label_source",
    "rubric_version",
    "fixture",
    "data_origin",
    "prompt_id",
    "document_kind",
    "input_state_record_id",
    "substep",
    "input_fact_record_id",
    "input_fact_sha256",
    "activation_sha256",
    "request_sent_at_utc",
    "input_manuscript_record_id",
    "input_review_record_id",
    "input_description_record_id",
    "history_mode",
    "history_record_ids",
    "prefix_record_ids",
    "lineage_root_record_id",
    "intervention_type",
    "intervention_id",
    "reset_from_record_id",
    "terminal_no_issue"
  ],
  "properties": {
    "schema_version": {
      "const": "2.3"
    },
    "record_id": {
      "type": "string",
      "pattern": "^conv_[A-Za-z0-9_-]+$"
    },
    "paper_id": {
      "type": "string"
    },
    "track": {
      "enum": [
        "A",
        "B",
        "PERTURBATION_TRACK",
        "development"
      ]
    },
    "condition": {
      "enum": [
        "A_INDEPENDENT",
        "A_LOOP",
        "B_DESCRIPTIVE",
        "B_DIRECT",
        "B_DIRECT2",
        "B_INITIAL",
        "B_REVIEW",
        "C_KEEP",
        "C_PERTURB",
        "DEVELOPMENT"
      ]
    },
    "trajectory_id": {
      "type": "integer",
      "minimum": 1
    },
    "round": {
      "type": "integer",
      "minimum": 0,
      "description": "Index of the OUTPUT artifact: R(t), U(t), Q(t). B Q(t) consumes U(t-1) and Q(t-1). C uses absolute indices 10..13."
    },
    "stage": {
      "enum": [
        "review",
        "manuscript",
        "description",
        "intervention"
      ]
    },
    "status": {
      "enum": [
        "success",
        "transient_api_error",
        "context_overflow",
        "truncated",
        "empty",
        "refusal",
        "off_task",
        "parse_failure",
        "unresolved_status",
        "initial_equivalence_failure"
      ]
    },
    "parent_record_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "raw_text": {
      "type": "string"
    },
    "model_snapshot": {
      "type": [
        "string",
        "null"
      ]
    },
    "input_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "output_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reasoning_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cache_read_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cache_write_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cost_amount": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "elapsed_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "critique_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cumulative_critique_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "critique_count_source": {
          "enum": [
            "P11_human_validated",
            "not_applicable",
            "unknown"
          ]
        },
        "critique_count_record_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "generation_call_count": {
          "type": "integer",
          "minimum": 0
        },
        "cumulative_generation_call_count": {
          "type": "integer",
          "minimum": 0
        },
        "unknown_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "reasoning_tokens",
        "cache_read_tokens",
        "cache_write_tokens",
        "cost_amount",
        "currency",
        "elapsed_seconds",
        "critique_count",
        "cumulative_critique_count",
        "critique_count_source",
        "critique_count_record_id",
        "generation_call_count",
        "cumulative_generation_call_count",
        "unknown_reason"
      ],
      "additionalProperties": false
    },
    "illustrative": {
      "type": "boolean"
    },
    "namespace": {
      "const": "CONVERGENCE"
    },
    "study_id": {
      "const": "conv_review_trajectory"
    },
    "evidence_class": {
      "enum": [
        "engineering_validation",
        "synthetic_identifiability",
        "unapproved_candidate_discovery",
        "pilot_llm_judge_labeled",
        "pilot_llm_judge_labeled_batch2",
        "diagnostic_only"
      ]
    },
    "label_source": {
      "type": "string",
      "minLength": 1
    },
    "rubric_version": {
      "type": "string",
      "minLength": 1
    },
    "fixture": {
      "type": "boolean"
    },
    "data_origin": {
      "enum": [
        "real",
        "illustrative",
        "fixture",
        "synthetic"
      ]
    },
    "prompt_id": {
      "enum": [
        "INPUT",
        "P01",
        "P02",
        "P04",
        "P05",
        "P06",
        "P07",
        "P08"
      ]
    },
    "document_kind": {
      "enum": [
        "manuscript",
        "review",
        "description"
      ]
    },
    "input_state_record_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "substep": {
      "enum": [
        null,
        1,
        2
      ]
    },
    "input_fact_record_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "input_fact_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "activation_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "request_sent_at_utc": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "input_manuscript_record_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "input_review_record_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "input_description_record_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "history_mode": {
      "enum": [
        "previous_review_only",
        "none",
        "full_critique_history"
      ]
    },
    "history_record_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "prefix_record_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "lineage_root_record_id": {
      "type": "string",
      "minLength": 1
    },
    "intervention_type": {
      "enum": [
        "NONE",
        "KEEP",
        "PERTURB",
        "RESET"
      ]
    },
    "intervention_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "reset_from_record_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "terminal_no_issue": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "track": {
            "const": "A"
          }
        },
        "required": [
          "track"
        ]
      },
      "then": {
        "properties": {
          "condition": {
            "enum": [
              "A_INDEPENDENT",
              "A_LOOP"
            ]
          },
          "stage": {
            "enum": [
              "review"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "track": {
            "const": "B"
          }
        },
        "required": [
          "track"
        ]
      },
      "then": {
        "properties": {
          "condition": {
            "enum": [
              "B_DESCRIPTIVE",
              "B_DIRECT",
              "B_DIRECT2",
              "B_INITIAL",
              "B_REVIEW"
            ]
          },
          "stage": {
            "enum": [
              "review",
              "manuscript",
              "description"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "track": {
            "const": "PERTURBATION_TRACK"
          }
        },
        "required": [
          "track"
        ]
      },
      "then": {
        "properties": {
          "condition": {
            "enum": [
              "C_KEEP",
              "C_PERTURB"
            ]
          },
          "stage": {
            "enum": [
              "review",
              "intervention"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "track": {
            "const": "development"
          }
        },
        "required": [
          "track"
        ]
      },
      "then": {
        "properties": {
          "condition": {
            "enum": [
              "DEVELOPMENT"
            ]
          },
          "stage": {
            "enum": [
              "review",
              "manuscript",
              "description",
              "intervention"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "condition": {
            "const": "B_INITIAL"
          }
        },
        "required": [
          "condition"
        ]
      },
      "then": {
        "properties": {
          "stage": {
            "enum": [
              "manuscript"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "condition": {
            "const": "B_REVIEW"
          }
        },
        "required": [
          "condition"
        ]
      },
      "then": {
        "properties": {
          "stage": {
            "enum": [
              "review",
              "manuscript"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "condition": {
            "const": "B_DIRECT"
          }
        },
        "required": [
          "condition"
        ]
      },
      "then": {
        "properties": {
          "stage": {
            "enum": [
              "manuscript"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "condition": {
            "const": "B_DIRECT2"
          }
        },
        "required": [
          "condition"
        ]
      },
      "then": {
        "properties": {
          "stage": {
            "enum": [
              "manuscript"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "condition": {
            "const": "B_DESCRIPTIVE"
          }
        },
        "required": [
          "condition"
        ]
      },
      "then": {
        "properties": {
          "stage": {
            "enum": [
              "manuscript",
              "description"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "prompt_id": {
            "not": {
              "const": "INPUT"
            }
          }
        },
        "required": [
          "prompt_id"
        ]
      },
      "then": {
        "properties": {
          "input_state_record_id": {
            "type": "string",
            "minLength": 1
          },
          "input_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "usage": {
            "properties": {
              "generation_call_count": {
                "minimum": 1
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "request_sent_at_utc": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "track": {
            "enum": [
              "A",
              "B",
              "PERTURBATION_TRACK"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "trajectory_id": {
            "maximum": 3
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "track": {
            "const": "A"
          }
        }
      },
      "then": {
        "properties": {
          "round": {
            "maximum": 10
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "track": {
            "const": "B"
          },
          "stage": {
            "enum": [
              "review",
              "description"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "round": {
            "maximum": 9
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "track": {
            "const": "B"
          },
          "stage": {
            "const": "manuscript"
          },
          "condition": {
            "not": {
              "const": "B_INITIAL"
            }
          }
        }
      },
      "then": {
        "properties": {
          "round": {
            "minimum": 1,
            "maximum": 10
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "condition": {
            "const": "B_INITIAL"
          }
        }
      },
      "then": {
        "properties": {
          "round": {
            "const": 0
          },
          "prompt_id": {
            "enum": [
              "INPUT",
              "P02"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "track": {
            "const": "PERTURBATION_TRACK"
          }
        }
      },
      "then": {
        "properties": {
          "round": {
            "minimum": 10,
            "maximum": 13
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "prompt_id": {
            "const": "INPUT"
          }
        }
      },
      "then": {
        "properties": {
          "track": {
            "const": "B"
          },
          "condition": {
            "const": "B_INITIAL"
          },
          "request_sent_at_utc": {
            "type": "null"
          }
        }
      }
    }
  ]
}
