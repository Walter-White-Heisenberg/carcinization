{
  "type": "object",
  "properties": {
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "answered",
              "unanswerable_from_text",
              "ambiguous"
            ]
          },
          "answer": {
            "type": [
              "string",
              "null"
            ]
          },
          "supporting_quote": {
            "type": [
              "string",
              "null"
            ]
          },
          "location": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "question_id",
          "status",
          "answer",
          "supporting_quote",
          "location"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "answers"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
