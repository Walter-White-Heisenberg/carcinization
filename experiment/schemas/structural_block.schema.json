{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "document_id",
    "block_id",
    "block_type",
    "start",
    "end",
    "text",
    "role",
    "heading_path",
    "list_depth",
    "schema_version",
    "namespace",
    "study_id",
    "record_id",
    "evidence_class",
    "label_source",
    "rubric_version",
    "fixture",
    "illustrative",
    "data_origin",
    "parent_record_ids"
  ],
  "properties": {
    "document_id": {
      "type": "string"
    },
    "block_id": {
      "type": "string"
    },
    "block_type": {
      "enum": [
        "heading",
        "paragraph",
        "list_item",
        "code",
        "math",
        "table"
      ]
    },
    "start": {
      "type": "integer",
      "minimum": 0
    },
    "end": {
      "type": "integer",
      "minimum": 0
    },
    "text": {
      "type": "string"
    },
    "role": {
      "type": [
        "string",
        "null"
      ]
    },
    "heading_path": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "list_depth": {
      "type": "integer",
      "minimum": 0
    },
    "heading_level": {
      "type": [
        "integer",
        "null"
      ]
    },
    "schema_version": {
      "const": "2.3"
    },
    "namespace": {
      "const": "CONVERGENCE"
    },
    "study_id": {
      "const": "conv_review_trajectory"
    },
    "evidence_class": {
      "enum": [
        "engineering_validation",
        "synthetic_identifiability",
        "unapproved_candidate_discovery",
        "pilot_llm_judge_labeled",
        "pilot_llm_judge_labeled_batch2",
        "diagnostic_only"
      ]
    },
    "record_id": {
      "type": "string",
      "pattern": "^conv_[A-Za-z0-9_-]+$"
    },
    "label_source": {
      "type": "string",
      "minLength": 1
    },
    "rubric_version": {
      "type": "string",
      "minLength": 1
    },
    "fixture": {
      "type": "boolean"
    },
    "illustrative": {
      "type": "boolean"
    },
    "data_origin": {
      "enum": [
        "real",
        "illustrative",
        "fixture",
        "synthetic"
      ]
    },
    "parent_record_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
