{
  "type": "object",
  "properties": {
    "judgments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "label": {
            "enum": [
              "supported",
              "partially_supported",
              "insufficient_support",
              "contradicted",
              "unassessable"
            ]
          },
          "supported_scope": {
            "type": "string"
          },
          "missing_link": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "claim_id",
          "label",
          "supported_scope",
          "missing_link",
          "evidence_ids",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "judgments"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
